rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function me() {
      return userDoc(request.auth.uid);
    }

    function isSuperAdmin() {
      return isSignedIn() && me().role == 'super_admin';
    }

    // Permissions system (scoped "admin_equipo" role): a super_admin still
    // sees/does everything everywhere. An admin_equipo only manages the
    // teams listed in their own `managedGroupIds`, and only for the actions
    // covered by their individual `permissions` map — see AppPermissions on
    // the client (lib/core/constants/app_constants.dart) for the five keys.
    // A trabajador_normal never reaches any of these (isSignedIn() && role
    // check inside each function requires 'admin_equipo' specifically).
    function myManagedGroupIds() {
      return me().get('managedGroupIds', []);
    }

    function hasPermission(key) {
      return isSuperAdmin()
        || (isSignedIn() && me().role == 'admin_equipo'
            && me().get('permissions', {}).get(key, false) == true);
    }

    // True if the signed-in user manages [groupId] — always true for
    // super_admin, true for admin_equipo only when groupId is one of their
    // assigned teams. Doesn't check any specific permission key by itself;
    // combine with hasPermission() for write actions.
    function managesGroup(groupId) {
      return isSuperAdmin()
        || (isSignedIn() && me().role == 'admin_equipo'
            && groupId != null && groupId in myManagedGroupIds());
    }

    // Shared write-gate for the per-team-scoped catalogs (taskTypes,
    // statuses, availableHours): a super_admin may write any entry,
    // including a "universal" one (empty groupIds = applies to every team).
    // An admin_equipo with manageCatalogs may only write entries that are
    // explicitly scoped to teams they manage — never empty/universal, since
    // that would silently affect teams outside their control.
    function canWriteScopedCatalog(newGroupIds) {
      return isSuperAdmin()
        || (hasPermission('manageCatalogs')
            && newGroupIds.size() > 0
            && newGroupIds.hasOnly(myManagedGroupIds()));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // True if the signed-in user may see/manage a task, mirroring
    // `isTaskVisibleToUser` on the client:
    // - super_admin sees/manages every task.
    // - admin_equipo sees/manages every task belonging to one of their
    //   managed teams (managesGroup), regardless of the manageTasks
    //   permission — visibility comes from the team assignment itself;
    //   manageTasks additionally gates writes, see below.
    // - a task with visibleToAllGroups == true is visible to any
    //   signed-in user.
    // - otherwise a normal user may only access tasks whose groupId
    //   matches their own groupId.
    // - tasks created before this feature have no groupId field at all;
    //   `.get('groupId', null)` defaults those to null, so (per the rule
    //   above) only super_admin/managing admins can access them until
    //   they're assigned a group.
    function canAccessTask(task) {
      return isSuperAdmin()
        || managesGroup(task.get('groupId', null))
        || (task.get('groupId', null) != null
            && (task.get('visibleToAllGroups', false) == true
                || task.get('groupId', null) == me().groupId));
    }

    // Additionally required for create/update: an admin_equipo may only
    // write (not just see) a task if they hold the manageTasks permission.
    // Always true for super_admin and trabajador_normal (unaffected by this
    // permissions system).
    function canWriteTask() {
      return me().role != 'admin_equipo' || hasPermission('manageTasks');
    }

    // Sprint 7.4.9B — only the task's current assignedUserId or a
    // super_admin may directly change the reminder. Mirrors the rule
    // enforced client-side in AddEditTaskPage (Encargado edita su propio
    // recordatorio / Administrador edita cualquiera).
    function canEditReminder() {
      return isSuperAdmin()
        || request.auth.uid == resource.data.get('assignedUserId', null);
    }

    // True when this write leaves reminderTime/reminderSent exactly as they
    // were — any user who already passes canAccessTask() may still edit
    // every other field freely (complete, soft-delete, edit other fields).
    function reminderUnchanged() {
      return request.resource.data.get('reminderTime', null) == resource.data.get('reminderTime', null)
        && request.resource.data.get('reminderSent', false) == resource.data.get('reminderSent', false);
    }

    // True when date/hour is changing — a reschedule, which legitimately
    // recalculates/clears the reminder as a side effect and is intentionally
    // not gated by canEditReminder() (reschedule permissions are unchanged
    // by this sprint).
    function taskTimeChanged() {
      return request.resource.data.get('date', null) != resource.data.get('date', null)
        || request.resource.data.get('hour', null) != resource.data.get('hour', null);
    }

    // -----------------------------------------------------------------
    // users
    // -----------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();
      // Accounts are provisioned from the admin panel: super_admin always;
      // an admin_equipo with manageUsers may only create a trabajador_normal
      // directly into one of their own managed teams — never another admin.
      allow create: if isSuperAdmin()
        || (hasPermission('manageUsers')
            && request.resource.data.role == 'trabajador_normal'
            && request.resource.data.groupId in myManagedGroupIds());
      // super_admin can edit any field (role, group, permissions, etc).
      // An admin_equipo with manageUsers may edit a trabajador_normal who
      // is (and, if their team is being changed, remains) in one of their
      // own managed teams — they can never touch role, and never touch an
      // admin or super_admin account. Regular users may only update the
      // fields the app touches on their own behalf, including their own
      // visual preferences (themeMode/accentColor).
      allow update: if isSuperAdmin()
        || (isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['fcmTokens', 'lastLogin', 'streakDays', 'maxStreakDays', 'name', 'themeMode', 'accentColor',  'photoUrl', 'pushNotificationMode']))
        || (hasPermission('manageUsers')
            && resource.data.role == 'trabajador_normal'
            && managesGroup(resource.data.groupId)
            && request.resource.data.role == 'trabajador_normal'
            && managesGroup(request.resource.data.groupId));
      // Permanent delete stays super_admin-only, same as the Cloud Function
      // (functions/src/deleteUser.js) that actually performs it.
      allow delete: if isSuperAdmin();
    }

    // -----------------------------------------------------------------
    // tasks
    // -----------------------------------------------------------------
    match /tasks/{taskId} {
      // Single-document reads: `resource.data` is concrete here, so the
      // get()-based canAccessTask() check evaluates per document as expected.
      allow get: if isSignedIn() && canAccessTask(resource.data);
      // Collection queries (watchTasksForDate/watchTasksInRange): rules
      // aren't filters. canAccessTask() depends on resource.data fields
      // that vary per doc and aren't constrained by the date/hour query
      // filters, so for any role other than super_admin (the only branch
      // that's constant w.r.t. resource.data) Firestore can't prove the
      // rule holds for the whole result set and rejects the ENTIRE query
      // with permission-denied. So list is open to any signed-in user;
      // privacy is enforced client-side via isTaskVisibleToUser
      // (lib/core/utils/task_visibility.dart), same as groups/taskTypes/etc.
      allow list: if isSignedIn();
      allow create: if isSignedIn() && canAccessTask(request.resource.data) && canWriteTask();
      // Sprint 7.4.9B: a direct change to reminderTime/reminderSent (not a
      // side effect of rescheduling) additionally requires canEditReminder()
      // — the task's current assignedUserId or a super_admin.
      allow update: if isSignedIn()
        && canAccessTask(resource.data)
        && canAccessTask(request.resource.data)
        && canWriteTask()
        && (reminderUnchanged() || taskTimeChanged() || canEditReminder());
      // Permanent delete: super_admin always, or an admin_equipo with
      // manageTasks deleting a task that belongs to one of their teams.
      // Soft delete uses update() above and is available to any signed-in
      // user who can access the task.
      allow delete: if isSuperAdmin()
        || (hasPermission('manageTasks') && managesGroup(resource.data.get('groupId', null)));
    }

    // -----------------------------------------------------------------
    // Catalog collections: readable by any signed-in user (needed to
    // resolve names/colors throughout the app), editable by super_admin or
    // a scoped admin_equipo with the matching permission.
    // -----------------------------------------------------------------
    match /groups/{id} {
      allow read: if isSignedIn();
      // Teams are created/deleted by super_admin only — an admin_equipo
      // never creates/removes teams, even their own.
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (hasPermission('manageTeams') && managesGroup(id));
      allow delete: if isSuperAdmin();
    }

    match /taskTypes/{id} {
      allow read: if isSignedIn();
      allow create: if canWriteScopedCatalog(request.resource.data.get('groupIds', []));
      allow update: if canWriteScopedCatalog(request.resource.data.get('groupIds', []));
      allow delete: if canWriteScopedCatalog(resource.data.get('groupIds', []));
    }

    match /statuses/{id} {
      allow read: if isSignedIn();
      allow create: if canWriteScopedCatalog(request.resource.data.get('groupIds', []));
      allow update: if canWriteScopedCatalog(request.resource.data.get('groupIds', []));
      allow delete: if canWriteScopedCatalog(resource.data.get('groupIds', []));
    }

    match /availableHours/{id} {
      allow read: if isSignedIn();
      allow create: if canWriteScopedCatalog(request.resource.data.get('groupIds', []));
      allow update: if canWriteScopedCatalog(request.resource.data.get('groupIds', []));
      allow delete: if canWriteScopedCatalog(resource.data.get('groupIds', []));
    }

    // -----------------------------------------------------------------
    // clients — not team-scoped (any admin_equipo with manageClients may
    // edit any client, regardless of managedGroupIds). `create` is
    // deliberately open to any signed-in user (not gated by manageClients):
    // the task-save flow (add_edit_task_page.dart/task_create_panel.dart)
    // auto-creates a lightweight client record the first time a new
    // name+phone is typed, for ANY user who can create a task — restricting
    // create to manageClients would break that for everyone who doesn't
    // hold the admin permission. Editing/deleting an existing client's
    // info, and the admin "Clientes" screen itself, stay permission-gated.
    // -----------------------------------------------------------------
    match /clients/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSuperAdmin() || hasPermission('manageClients');
      allow delete: if isSuperAdmin() || hasPermission('manageClients');
    }

    // -----------------------------------------------------------------
    // systemConfig — global system configuration (Sprint 22)
    // Readable by any signed-in user (all screens need the current mode);
    // writable only by super_admin. The time-selection toggle this doc used
    // to hold moved to per-team (`groups/{id}.timeSelectionMode`); this
    // collection is kept for any other future global setting.
    // -----------------------------------------------------------------
    match /systemConfig/{doc} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // -----------------------------------------------------------------
    // notifications (Sprint 7.4 — in-app notification center)
    // -----------------------------------------------------------------
    match /notifications/{id} {
      // Documents are written only by Cloud Functions via the
      // firebase-admin SDK, which bypasses Security Rules entirely — so
      // clients can never fabricate a notification for themselves or
      // anyone else.
      allow create: if false;
      // Single-document reads: resource.data is concrete here, so this
      // evaluates per document as expected.
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Collection queries (watchNotifications/unreadCount): same rationale
      // as tasks' `list` rule above — rules can't constrain per-doc fields
      // across an arbitrary query result set, so list is open to any
      // signed-in user; privacy is enforced by the repository always
      // querying `where('userId', isEqualTo: <own uid>)`.
      allow list: if isSignedIn();
      // markAsRead/markAllAsRead: the owner may only flip isRead.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      // Sprint 7.4.7 Objetivo E/F: a user may delete their own notifications
      // (single delete or "vaciar historial") — never anyone else's, not
      // even super_admin, since this isn't an admin-moderation feature.
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
